      <column caption='Smart KPI Market Value' datatype='string' name='[Calculation_1271339524759556]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([team_name]) = MAX([team_name]) &#13;&#10;THEN MIN([team_name]) + &quot;: €&quot; + STR(ROUND(AVG([avg_market_value]) / 1000000, 1)) + &quot;M&quot;&#13;&#10;ELSE &quot;Tournament Avg: €&quot; + STR(ROUND(AVG([avg_market_value]) / 1000000, 1)) + &quot;M&quot;&#13;&#10;END' />
